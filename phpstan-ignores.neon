parameters:
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Symfony Console declares option values more narrowly than the runtime values accepted here.
        - { identifier: notIdentical.alwaysTrue, path: src/Console/GrigliaCheck.php }
        - { identifier: arrayValues.list, path: src/Console/GrigliaCheck.php }
        - { identifier: argument.type, path: src/Console/GrigliaCheck.php }
        # These guarded fallbacks intentionally tolerate partially populated command payloads and missing rows.
        - { identifier: nullCoalesce.offset, path: src/Console/GrigliaCheck.php }
        - { identifier: nullsafe.neverNull, path: src/Console/GrigliaCheck.php }

        # Eloquent relation create/find/query results keep the concrete model at runtime; Larastan loses it here.
        # Livewire render methods select registered package views dynamically.
        - { identifier: argument.type, message: '#Parameter \#1 \$view of function view expects view-string\|null, string given\.#', path: src/Livewire/* }

        - { identifier: return.type, path: src/Domain/ReviewWorkflow.php }
        - { identifier: method.notFound, path: src/Livewire/ChecklistSwitcher.php }
        - { identifier: return.type, path: src/Livewire/IngredientModal.php }
        - { identifier: return.type, path: src/Livewire/PlanPage.php }
        - { identifier: argument.type, path: src/Livewire/PlanPage.php }
        - { identifier: method.notFound, path: src/Livewire/PlansPage.php }
        - { identifier: return.type, path: src/Livewire/PlansPage.php }
        - { identifier: argument.type, path: src/Livewire/TodoList.php }
        - { identifier: argument.type, path: src/Models/Todo.php }
        - { identifier: method.notFound, path: src/Support/Context.php }
        - { identifier: return.type, path: src/Support/ImageStore.php }
        - { identifier: method.notFound, path: src/Support/Plan.php }
        - { identifier: return.type, path: src/Support/QuestionLevel.php }

        # SoftDeletes forwards withTrashed through Eloquent builders/relations, which PHPStan cannot see.
        - { identifier: method.notFound, path: src/Livewire/StatsPage.php }
        - { identifier: method.notFound, path: src/Models/Checklist.php }
        - { identifier: method.notFound, path: src/Support/Stats.php }

        # Defensive nullsafe/fallback branches support older or user-supplied data despite inferred non-null types.
        - { identifier: nullCoalesce.offset, path: src/Http/Controllers/ThemeAssetController.php }
        - { identifier: nullsafe.neverNull, path: src/Livewire/DashboardTodoList.php }
        - { identifier: nullsafe.neverNull, path: src/Livewire/IngredientModal.php }
        - { identifier: nullsafe.neverNull, path: src/Livewire/StatsPage.php }
        - { identifier: nullsafe.neverNull, path: src/Livewire/ThemedTodoList.php }
        - { identifier: nullsafe.neverNull, path: src/Livewire/TodoList.php }

        # Compatibility guards deliberately support multiple Laravel AI / PHP extension versions and invalid input.
        - { identifier: function.alreadyNarrowedType, path: src/Http/Controllers/TranscribeController.php }
        - { identifier: match.unhandled, path: src/Support/ImageStore.php }
        - { identifier: notIdentical.alwaysTrue, path: src/Support/Locale.php }
        - { identifier: notIdentical.alwaysTrue, path: src/ThemeStore.php }

        # The parser closure mutates a by-reference accumulator; PHPStan does not track that closure effect.
        - { identifier: booleanOr.alwaysTrue, path: src/Support/Context.php }
        - { identifier: identical.alwaysTrue, path: src/Support/Context.php }
        - { identifier: deadCode.unreachable, path: src/Support/Context.php }
