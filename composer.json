{
    "name": "alle80/griglia",
    "description": "A Laravel + Livewire task board where you queue work for your coding agent and follow it live: states, questions, progress and results, in your own app and database.",
    "type": "library",
    "homepage": "https://alle80.github.io/griglia/",
    "license": "MIT",
    "keywords": [
        "laravel",
        "laravel-package",
        "livewire",
        "task-board",
        "todo",
        "todolist",
        "checklist",
        "kanban",
        "agent",
        "coding-agent",
        "ai-agents",
        "griglia"
    ],
    "authors": [
        {
            "name": "Alessandro (alle80)",
            "email": "alle80@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/alle80/griglia/issues",
        "forum": "https://github.com/alle80/griglia/discussions",
        "source": "https://github.com/alle80/griglia",
        "docs": "https://alle80.github.io/griglia/",
        "security": "https://github.com/alle80/griglia/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/broadcasting": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "laravel-notification-channels/webpush": "^12.1",
        "league/commonmark": "^2.4",
        "livewire/livewire": "^4.4",
        "spatie/laravel-settings": "^3.4"
    },
    "suggest": {
        "laravel/ai": "AI descriptions of uploaded images, used by the search (any supported provider).",
        "laravel/reverb": "Live updates between devices via WebSocket (any Laravel broadcaster works)."
    },
    "autoload": {
        "psr-4": {
            "Alle80\\Griglia\\": "src/",
            "Alle80\\Griglia\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alle80\\Griglia\\GrigliaServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/ai": "^0.11.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Alle80\\Griglia\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --test",
            "vendor/bin/phpstan analyse"
        ],
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit",
        "test:coverage": "@php -d pcov.enabled=1 -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text --coverage-html=build/coverage",
        "docs:check": "vendor/bin/testbench griglia:docs-generate --check",
        "docs:build": "vendor/bin/testbench griglia:docs-build --strict",
        "qa": [
            "@lint",
            "@test",
            "@docs:check"
        ]
    },
    "scripts-descriptions": {
        "lint": "Coding style (Pint) and static analysis (PHPStan level 5), without changing a file.",
        "format": "Applies the coding style instead of only reporting it.",
        "test": "The PHPUnit suite through Testbench, on in-memory SQLite.",
        "test:coverage": "The suite with a code coverage report; needs the pcov or xdebug extension.",
        "docs:check": "Fails when the generated reference pages no longer match the code.",
        "docs:build": "Builds the bilingual documentation site with MkDocs, warnings treated as errors.",
        "qa": "Everything a pull request must pass, in the order CI runs it."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
